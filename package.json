{
  "name": "notemd",
  "productName": "NoteMd",
  "version": "0.3.0",
  "description": "A thoughtful, local-first Markdown editor",
  "author": "NoteMd contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "start": "node scripts/start.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win portable --x64 && node scripts/release-metadata.mjs",
    "test:portable": "node scripts/portable-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.0",
    "dompurify": "^3.3.0",
    "highlight.js": "^11.11.0",
    "katex": "^0.19.0",
    "lucide-react": "^0.577.0",
    "marked": "^18.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "org.notemd.desktop",
    "productName": "NoteMd",
    "directories": {
      "output": "release/NoteMd-${version}"
    },
    "files": [
      "dist/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "third-party/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "resources/icon.ico",
      "signExecutable": false
    },
    "artifactName": "NoteMd-${version}-${arch}.${ext}",
    "electronDist": "node_modules/electron/dist"
  },
  "allowScripts": {
    "electron@42.11.15": true,
    "esbuild@0.27.7": true
  }
}
